# D-KRAFT ERP - Production Environment
# IMPORTANTE: Copia este archivo a .env.production y configura los valores reales

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Feature Flags
VITE_USE_SUPABASE=true
VITE_USE_API=false

# QuickBooks Integration (Optional - handoff)
VITE_QB_CLIENT_ID=
VITE_QB_CLIENT_SECRET=
VITE_QB_REDIRECT_URI=
VITE_QB_ENVIRONMENT=production

# API Configuration (if using REST backend)
VITE_API_URL=https://api.dkraft.com.mx/api
